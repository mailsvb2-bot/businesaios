[Unit]
Description=BusinesAIOS Telegram Connector (optional polling adapter)
After=network-online.target businesaios-api.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=businesaios
Group=businesaios
WorkingDirectory=/opt/businesaios
EnvironmentFile=/etc/businesaios/api.env
EnvironmentFile=-/etc/businesaios/connectors/telegram.env
Environment=APP_PROFILE=telegram
Environment=LOG_LEVEL=INFO
ExecStartPre=/opt/businesaios/.venv/bin/python -m scripts.server.migrate_before_start
ExecStart=/opt/businesaios/.venv/bin/python -m scripts.server.run_profile
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=businesaios-connector-telegram

[Install]
WantedBy=multi-user.target
