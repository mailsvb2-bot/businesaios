# BusinesAIOS production environment template.
# This file is intentionally fail-closed. Runtime secrets and DSNs must be injected by the deployment environment.

APP_ENV=prod
ENV=prod
LOG_LEVEL=INFO
TENANT_ID=
BAIOS_DATA_DIR=/var/lib/businesaios/runtime
DATA_DIR=/var/lib/businesaios/runtime

# Production governance is fail-closed. PRICING_VERSION is an explicit
# operator-approved business version and is atomically bound by the canonical
# bootstrap_and_verify_production.sh lifecycle. Do not invent a fallback or use
# PRICING_VERSION_OVERRIDE_PATH in production. The mutable fingerprint belongs
# to the canonical systemd StateDirectory, not to the application checkout.
PRODUCTION_STRICT_MODE=1
PRICING_VERSION=
PRICING_FINGERPRINT_PATH=/var/lib/businesaios/runtime/governance/pricing_fingerprint.json

# Core runtime: API + channel-agnostic worker.
# Messaging providers are activated through provider onboarding. No messenger
# is mandatory and Telegram is not the default platform runtime.
APP_PROFILE=api
API_HOST=0.0.0.0
API_PORT=8000
HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8087
# Internal compatibility name used by runtime.evolution until that module is renamed.
EVOLUTION_HEALTH_PORT=8087
EVOLUTION_ENABLED=1

# Canonical production TLS boundary. Privileged control-plane requests enter
# through nginx over HTTPS. The application may honor X-Forwarded-* headers
# only from the loopback nginx peer; widening this network is not canonical.
PUBLIC_BASE_URL=https://api.businessaios.ru
BUSINESAIOS_TRUST_PROXY_HEADERS=true
BUSINESAIOS_TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

STORAGE_BACKEND=postgres
DATABASE_URL=
POSTGRES_DSN=
POSTGRES_RUNTIME_ENABLED=1
POSTGRES_EVENT_STORE_ENABLED=1
RUN_MIGRATIONS_BEFORE_START=1
POSTGRES_APPLY_MIGRATIONS=1
POSTGRES_LIVE_PROOF_REQUIRED=1
POSTGRES_BACKUP_EVIDENCE_OK=0
POSTGRES_BACKUP_EVIDENCE_PATH=
CONTAINER_RUNTIME_PROOF_REQUIRED=1
CONTAINER_RUNTIME_EVIDENCE_REQUIRED=1
REAL_RUNTIME_BOOT_EVIDENCE_REQUIRED=1
PRODUCTION_BOOT_PROOF_REQUIRED=1
BAIOS_REQUIRE_TRANSITIVE_DEPENDENCY_LOCK=1

# Production key-provider master key. Required when APP_ENV=prod/production.
# Generate 32 cryptographically random bytes and Base64-encode them; do not
# commit or log the generated value. Preserve it across deployments because
# existing wrapped key material cannot be decrypted with a different key.
BUSINESAIOS_KEY_PROVIDER_MASTER_KEY_B64=

# Security stores use the canonical persistent file backends by default. Their
# files live under DATA_DIR/security, which systemd maps to the writable
# StateDirectory at /var/lib/businesaios/runtime.
BUSINESAIOS_KEY_PROVIDER_BACKEND=file
BUSINESAIOS_SECRET_VAULT_BACKEND=file

# Production administrator topology. dual_control remains the fail-closed
# default. A deployment owned by one person may explicitly select single_owner;
# that mode still requires a real ADMIN_USER_IDS value and forbids self-approval.
GOVERNANCE_ADMIN_MODE=dual_control
ADMIN_USER_IDS=
ALLOW_SELF_APPROVE=0

# Optional Telegram provider connector. Keep empty unless this provider is
# activated. Long polling is a separate optional unit; webhook providers enter
# through the API/provider-webhook runtime.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=1
TELEGRAM_WEBHOOK_ENABLED=1
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_HOST=0.0.0.0
TELEGRAM_WEBHOOK_PORT=8080
TELEGRAM_WEBHOOK_AUTO_REGISTER=1
TELEGRAM_WEBHOOK_DROP_PENDING_UPDATES=0
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
TELEGRAM_WEBHOOK_ALLOWED_UPDATES=message,callback_query
TELEGRAM_HEALTH_PORT=8088

# Canonical control-plane credential lifecycle. The plaintext credential and
# SMOKE_TENANT_ID are written only by scripts/server/bootstrap_production_control_plane.py
# into /etc/businesaios/api.env. The application store persists key_id + hash;
# API_CONTROL_PLANE_API_KEY_PEPPER remains application-side secret material.
CONTROL_PLANE_API_KEY=
API_CONTROL_PLANE_API_KEY_PEPPER=
BUSINESAIOS_API_KEY_STORE_BACKEND=file
BUSINESAIOS_API_KEY_STORE_PATH=/var/lib/businesaios/runtime/api/api_keys.json
BUSINESAIOS_TENANT_REGISTRY_BACKEND=file
BUSINESAIOS_TENANT_REGISTRY_PATH=/var/lib/businesaios/runtime/tenancy/tenant_registry.json
BUSINESAIOS_TENANT_POLICY_STORE_BACKEND=file
BUSINESAIOS_TENANT_POLICY_STORE_PATH=/var/lib/businesaios/runtime/tenancy/tenant_policies.json
API_DOCS_ENABLED=0
# Exact browser origins allowed to call the API with the HttpOnly owner-resume cookie. No wildcards.
API_CORS_ALLOWED_ORIGINS=https://app.businessaios.ru
API_IDEMPOTENCY_PATH=/var/lib/businesaios/runtime/api/api_idempotency.sqlite3

# Post-deploy verification is intentionally fail-closed. SMOKE_TENANT_ID must
# identify an explicitly selected existing active production tenant. Do not
# hand-edit CONTROL_PLANE_API_KEY, SMOKE_TENANT_ID or PRICING_VERSION: run the
# canonical bootstrap lifecycle with explicit trusted inputs.
# EXPECTED_SHA is intentionally NOT persisted here: the deploy command must
# export the exact freshly deployed 40-character SHA for every run.
SMOKE_TENANT_ID=
PRODUCTION_VERDICT_DIR=/var/lib/businesaios/runtime/reports/post-deploy
