# BusinesAIOS production environment template.
# This file is intentionally fail-closed. Runtime secrets and DSNs must be injected by the deployment environment.

APP_ENV=prod
ENV=prod
LOG_LEVEL=INFO
TENANT_ID=
BAIOS_DATA_DIR=/var/lib/businesaios/runtime
DATA_DIR=/var/lib/businesaios/runtime

# Core runtime: API + channel-agnostic worker.
# Messaging providers are activated through provider onboarding. No messenger
# is mandatory and Telegram is not the default platform runtime.
APP_PROFILE=api
API_HOST=0.0.0.0
API_PORT=8000
HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8087
# Internal compatibility name used by runtime.evolution until that module is renamed.
EVOLUTION_HEALTH_PORT=8087
EVOLUTION_ENABLED=1

STORAGE_BACKEND=postgres
DATABASE_URL=
POSTGRES_DSN=
POSTGRES_RUNTIME_ENABLED=1
POSTGRES_EVENT_STORE_ENABLED=1
RUN_MIGRATIONS_BEFORE_START=1
POSTGRES_APPLY_MIGRATIONS=1
POSTGRES_LIVE_PROOF_REQUIRED=1
POSTGRES_BACKUP_EVIDENCE_OK=0
POSTGRES_BACKUP_EVIDENCE_PATH=
CONTAINER_RUNTIME_PROOF_REQUIRED=1
CONTAINER_RUNTIME_EVIDENCE_REQUIRED=1
REAL_RUNTIME_BOOT_EVIDENCE_REQUIRED=1
PRODUCTION_BOOT_PROOF_REQUIRED=1
BAIOS_REQUIRE_TRANSITIVE_DEPENDENCY_LOCK=1

# Production key-provider master key. Required when APP_ENV=prod/production.
# Generate 32 cryptographically random bytes and Base64-encode them; do not
# commit or log the generated value. Preserve it across deployments because
# existing wrapped key material cannot be decrypted with a different key.
BUSINESAIOS_KEY_PROVIDER_MASTER_KEY_B64=

# Security stores use the canonical persistent file backends by default. Their
# files live under DATA_DIR/security, which systemd maps to the writable
# StateDirectory at /var/lib/businesaios/runtime.
BUSINESAIOS_KEY_PROVIDER_BACKEND=file
BUSINESAIOS_SECRET_VAULT_BACKEND=file

# Optional Telegram provider connector. Keep empty unless this provider is
# activated. Long polling is a separate optional unit; webhook providers enter
# through the API/provider-webhook runtime.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=1
TELEGRAM_WEBHOOK_ENABLED=1
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_HOST=0.0.0.0
TELEGRAM_WEBHOOK_PORT=8080
TELEGRAM_WEBHOOK_AUTO_REGISTER=1
TELEGRAM_WEBHOOK_DROP_PENDING_UPDATES=0
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
TELEGRAM_WEBHOOK_ALLOWED_UPDATES=message,callback_query
TELEGRAM_HEALTH_PORT=8088

CONTROL_PLANE_API_KEY=
API_CONTROL_PLANE_API_KEY_PEPPER=
BUSINESAIOS_API_KEY_STORE_BACKEND=file
BUSINESAIOS_API_KEY_STORE_PATH=/var/lib/businesaios/runtime/api/api_keys.json
API_DOCS_ENABLED=0
API_IDEMPOTENCY_PATH=/var/lib/businesaios/runtime/api/api_idempotency.sqlite3
