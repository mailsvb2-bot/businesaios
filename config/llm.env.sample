# LLM disabled until explicitly configured
LLM_ENABLED=0
LLM_PROVIDER=yandexgpt
YANDEXGPT_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEXGPT_API_KEY=__PUT_KEY_HERE__
YANDEXGPT_FOLDER_ID=__PUT_FOLDER_ID_HERE__
YANDEXGPT_MODEL=yandexgpt-lite

# Alternative: LLM_PROVIDER=gigachat
# GIGACHAT_API_KEY is the Sber authorization key, exchanged via OAuth.
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Install Russian Trusted Root CA as trusted, or configure SSL_CERT_FILE.
# Foreign providers are blocked unless LLM_ALLOW_FOREIGN_PROVIDERS=1.
# Additional approved domestic hosts: LLM_SOVEREIGN_HOSTS=example.ru
# Never commit real keys. When disabled, fallback copy templates are used.
